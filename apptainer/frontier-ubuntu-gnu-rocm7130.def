Bootstrap: docker
From: ubuntu:22.04


%environment
export ROCM_PATH=/opt/rocm
export MPICH_DIR=/opt/mpich
export LD_LIBRARY_PATH="/opt/mpich/lib:/opt/rocm/lib:/opt/rocm/lib64:$LD_LIBRARY_PATH"
export PATH="/opt/mpich/bin:/opt/rocm/bin:$PATH"
export PYTORCH_DIR=/pytorch
export PYTHONPATH=${PYTORCH_DIR}:${PYTHONPATH}
export CONDA_DIR=/conda/envs/vit
export PATH=${CONDA_DIR}/bin:/conda/bin:$PATH
export MPICH_SMP_SINGLE_COPY_MODE=NONE

#Remove trailing : to avoid including CWD to system search paths
export C_INCLUDE_PATH=${C_INCLUDE_PATH%:}
export CPLUS_INCLUDE_PATH=${CPLUS_INCLUDE_PATH%:}

# Enable conda on apptainer run (https://github.com/apptainer/singularity/issues/5075)
action="${0##*/}"
if [ "$action" == "shell" ]; then
    if [ "${SINGULARITY_SHELL:-}" == "/bin/bash" ]; then
        set -- --noprofile --init-file /.singularity_bash
    elif test -z "${SINGULARITY_SHELL:-}"; then
        export SINGULARITY_SHELL=/bin/bash
        set -- --noprofile --init-file /.singularity_bash
    fi
fi


%post -c /bin/bash
set -eo pipefail
# Misc setup
export ROCM_PATH=/opt/rocm
export MPICH_DIR=/opt/mpich
export LD_LIBRARY_PATH="/opt/rocm/lib:/opt/rocm/lib64:$LD_LIBRARY_PATH"
export PATH="/opt/rocm/bin:$PATH"
export MPICH_SMP_SINGLE_COPY_MODE=NONE
export DEBIAN_FRONTEND=noninteractive

#Remove trailing : to avoid including CWD to system search paths
export C_INCLUDE_PATH=${C_INCLUDE_PATH%:}
export CPLUS_INCLUDE_PATH=${CPLUS_INCLUDE_PATH%:}

# This base image is plain ubuntu:22.04 from Docker Hub, not OLCF's own
# savannah.ornl.gov CPE registry -- that registry is currently blocking
# pulls of its own documented images on a vulnerability-severity policy
# (OLCF's own docs acknowledge this and point at building your own image
# as the workaround: https://docs.olcf.ornl.gov/software/containers_on_frontier.html).
# This also means CPE was never actually bundled in those images anyway --
# OLCF's docs say outright they can't ship real CPE in a container due to
# licensing, so this approach (plain base + our own ABI-matched MPICH, same
# as OLCF's own olcf_containers_examples repo) isn't a downgrade.
#
# No `sudo` anywhere below -- %post already runs as root under apptainer's
# fakeroot build, and `sudo` itself can't allocate a pty in that environment
# ("unable to allocate pty: Invalid argument"), which silently no-ops every
# command it prefixes instead of erroring, cascading into later steps failing
# on missing tools. `set -e` above also makes any future step like this fail
# loudly instead of silently continuing.
apt-get update

# Installing some prerequisites
apt-get install -y build-essential gfortran git tar wget gnupg \
  autoconf automake libtool m4 texinfo zlib1g-dev pkg-config ca-certificates
apt-get install -y libatomic1 libquadmath0  # required by some ROCm tools -- see https://rocm.docs.amd.com/en/7.13.0-preview/install/rocm.html

# Build MPICH 3.4.2 from source, matching the ANL MPICH release Cray MPICH's
# own ABI is based on (confirmed via `module show cray-mpich/8.1.31` on
# Frontier -> "based upon ANL MPICH 3.4a2"; 3.4.2 is the nearest stable
# release and is the same version OLCF's own example targets for this ABI --
# see opensusempich342rocm624.def in https://github.com/olcf/olcf_containers_examples).
# This container's own MPICH is never meant to run anything itself -- it only
# needs to be ABI-compatible so the real Cray MPICH (bound in from the host
# at job-submission time, see launch/basic_ct/unetr_apptainer.sh) can replace
# it at runtime without breaking anything linked against it at build time.
export MPICH_VERSION=3.4.2
export MPICH_URL="http://www.mpich.org/static/downloads/${MPICH_VERSION}/mpich-${MPICH_VERSION}.tar.gz"
mkdir -p /mpich
cd /mpich
wget -O mpich-${MPICH_VERSION}.tar.gz ${MPICH_URL}
tar --no-same-owner -xzf mpich-${MPICH_VERSION}.tar.gz
cd /mpich/mpich-${MPICH_VERSION}
FFLAGS="-fallow-argument-mismatch" FCFLAGS="-fallow-argument-mismatch" \
  ./configure --with-device=ch4:ofi --prefix=${MPICH_DIR}
make -j32 install
cd /
rm -rf /mpich
export PATH="${MPICH_DIR}/bin:$PATH"
export LD_LIBRARY_PATH="${MPICH_DIR}/lib:$LD_LIBRARY_PATH"

# Install ROCm 7.13.0-preview userspace packages for gfx90a (MI250X), to match
# the Conda env's own target in README.md's Install section.
# See: https://rocm.docs.amd.com/en/7.13.0-preview/install/rocm.html
mkdir --parents --mode=0755 /etc/apt/keyrings
wget https://repo.amd.com/rocm/packages/gpg/rocm.gpg -O - | \
  gpg --dearmor | tee /etc/apt/keyrings/amdrocm.gpg > /dev/null
tee /etc/apt/sources.list.d/rocm.list << EOF
deb [arch=amd64 signed-by=/etc/apt/keyrings/amdrocm.gpg] https://repo.amd.com/rocm/packages/ubuntu2204 stable main
EOF
apt update
apt install -y amdrocm7.13-gfx90a amdrocm-core-dev7.13-gfx90a

# Install CONDA and required conda packages
export CONDA_DIR=/conda/envs/vit
export PATH=${CONDA_DIR}/bin:/conda/bin:$PATH
wget https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh && \
  bash /tmp/miniforge.sh -b -p /conda && \
  rm -f /tmp/miniforge.sh && \
  . /conda/etc/profile.d/conda.sh && \
  . /conda/bin/activate && \
  conda create -n vit python=3.11 -y
  conda install -n vit -y git

echo "## Activate conda environment" >> /.singularity_bashrc
echo "conda activate vit" >> /.singularity_bashrc

# Install PyTorch -- exact command from AMD's own ROCm 7.13.0-preview +
# PyTorch 2.10.0 + MI250X/gfx90a install guide (matches README.md's Conda
# install section): https://rocm.docs.amd.com/en/7.13.0-preview/frameworks/pytorch/install.html
export PYTORCH_DIR=/pytorch
export PYTHONPATH=${PYTORCH_DIR}:${PYTHONPATH}
${CONDA_DIR}/bin/pip install --index-url https://repo.amd.com/rocm/whl/gfx90a/ \
  "torch==2.10.0+rocm7.13.0" \
  "torchvision==0.25.0+rocm7.13.0" \
  "torchaudio==2.10.0+rocm7.13.0" \
  --target ${PYTORCH_DIR}

# Install XFormers
${CONDA_DIR}/bin/pip install -U xformers --index-url https://download.pytorch.org/whl/rocm7.1

# Install mpi4py against the MPICH we just built above, so it's linked
# against something ABI-compatible with Cray MPICH once bound in at runtime
# (see launch/basic_ct/unetr_apptainer.sh)
MPICC="${MPICH_DIR}/bin/mpicc" ${CONDA_DIR}/bin/pip install --no-cache-dir --no-binary=mpi4py mpi4py

# Install UCF_VIT
#mkdir -p /source
#cd /source
#git clone https://github.com/irlyngaas/UCF-VIT.git
#${CONDA_DIR}/bin/python -m pip install -e /source/UCF-VIT --verbose

%runscript
exec /bin/bash --noprofile --init-file /.singularity_bash "$@"
%startscript
exec /bin/bash --noprofile --init-file /.singularity_bash "$@"
